{
  "name": "@deposium/cli",
  "version": "1.9.2",
  "description": "CLI for Deposium MCP Server - Document search, graph queries, and AI workflows",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "deposium": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "build:bun": "bun build --compile --minify src/cli.ts --outfile dist/deposium",
    "build:all": "npm run build:bun-linux && npm run build:bun-macos && npm run build:bun-windows",
    "build:bun-linux": "bun build --compile --target=linux-x64 --minify src/cli.ts --outfile dist/deposium-linux",
    "build:bun-macos": "bun build --compile --target=darwin-x64 --minify src/cli.ts --outfile dist/deposium-macos",
    "build:bun-windows": "bun build --compile --target=windows-x64 --minify src/cli.ts --outfile dist/deposium-windows.exe",
    "start": "node dist/cli.js",
    "install:local": "npm run build && npm link",
    "uninstall:local": "npm unlink -g @deposium/cli",
    "pack:local": "npm run build && npm pack",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.demo.json",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist node_modules",
    "prepare": "husky || true",
    "demo:ui": "tsx demo-ui.ts"
  },
  "keywords": [
    "deposium",
    "mcp",
    "cli",
    "search",
    "graph",
    "ai",
    "rag",
    "duckdb"
  ],
  "author": "The Seed Ship",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theseedship/deposium_CLI.git"
  },
  "homepage": "https://github.com/theseedship/deposium_CLI#readme",
  "bugs": {
    "url": "https://github.com/theseedship/deposium_CLI/issues"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "boxen": "^9.0.0",
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "commander": "^15.1.0",
    "conf": "^16.0.0",
    "dotenv": "^18.0.10",
    "glob": "^14.0.4",
    "gradient-string": "^3.0.0",
    "inquirer": "^14.3.0",
    "marked": "^18.2.0",
    "marked-terminal": "^7.3.1",
    "mime-types": "^3.0.2",
    "ora": "^10.0.0",
    "@inquirer/core": "12.1.0"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "yaml": "2.9.1",
    "@eslint/js": "^10.0.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "bun": ">=1.0.0"
  },
  "overrides": {
    "minimatch": ">=10.2.4",
    "rollup": ">=4.59.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
